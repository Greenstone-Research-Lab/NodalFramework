<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Nodal.Core\Nodal.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Neo4j.Driver" Version="6.3.0" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackageId>Nodal.Neo4j</PackageId>
    <Title>Nodal Framework Provider for Neo4j</Title>
    <Description>Neo4j provider for Nodal Framework with Cypher translation, pooled Bolt connections, transactions, and migrations.</Description>
    <PackageTags>$(PackageTags);neo4j;cypher;bolt</PackageTags>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

</Project>
