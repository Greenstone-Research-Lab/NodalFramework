{
  "@context": {
    "schema": "https://schema.org/",
    "nodal": "https://nodalframework.pages.dev/vocabulary/",
    "name": "schema:name",
    "description": "schema:description",
    "requires": {"@id": "nodal:requires", "@type": "@id"},
    "provides": {"@id": "nodal:provides", "@type": "@id"},
    "uses": {"@id": "nodal:uses", "@type": "@id"},
    "supports": {"@id": "nodal:supports", "@type": "@id"},
    "algorithms": "nodal:algorithms"
  },
  "@graph": [
    {"@id": "nodal:NodalContext", "@type": "nodal:CoreType", "name": "NodalContext", "description": "Bounded graph unit of work and provider execution boundary.", "provides": ["nodal:GraphSet", "nodal:RelationSet", "nodal:ChangeTracking", "nodal:DatabaseFacade"]},
    {"@id": "nodal:GraphSet", "@type": "nodal:GenericType", "name": "GraphSet<TNode>", "description": "Strongly typed node query and mutation entry point.", "requires": "nodal:NodePoco", "supports": ["nodal:Query", "nodal:NodeMutation"]},
    {"@id": "nodal:RelationSet", "@type": "nodal:GenericType", "name": "RelationSet<TSource, TRelation, TTarget>", "description": "Strongly typed edge traversal and mutation entry point.", "requires": ["nodal:NodePoco", "nodal:RelationPoco"], "supports": ["nodal:Traversal", "nodal:RelationMutation"]},
    {"@id": "nodal:NodePoco", "@type": "nodal:ModelConstraint", "name": "Node POCO", "requires": "nodal:GraphNodeAttribute"},
    {"@id": "nodal:RelationPoco", "@type": "nodal:ModelConstraint", "name": "Relationship POCO", "requires": "nodal:GraphRelationAttribute"},
    {"@id": "nodal:GraphNodeAttribute", "@type": "nodal:Attribute", "name": "GraphNodeAttribute"},
    {"@id": "nodal:GraphRelationAttribute", "@type": "nodal:Attribute", "name": "GraphRelationAttribute"},
    {"@id": "nodal:Query", "@type": "nodal:Capability", "name": "Provider-neutral query", "supports": ["nodal:Filtering", "nodal:Ordering", "nodal:Paging", "nodal:Projection", "nodal:Aggregates"]},
    {"@id": "nodal:Traversal", "@type": "nodal:Capability", "name": "Typed graph traversal", "supports": ["nodal:Direction", "nodal:BoundedDepth", "nodal:PathPayload"]},
    {"@id": "nodal:Neo4jProvider", "@type": "nodal:Provider", "name": "Nodal.Neo4j", "description": "Live QA baseline: Neo4j 5.26 Community with Neo4j.Driver 6.3.0. Neo4j 5.26 requires GDS 2.13; per-algorithm live analytics certification is pending.", "uses": ["nodal:Cypher", "nodal:Bolt", "nodal:Neo4jGDS"], "supports": ["nodal:Query", "nodal:Traversal", "nodal:MutationTransaction", "nodal:Migrations", "nodal:ConditionalAnalytics"]},
    {"@id": "nodal:TigerGraphProvider", "@type": "nodal:Provider", "name": "Nodal.TigerGraph", "description": "Live QA baseline: TigerGraph 4.2.4 Community. Analytics require explicitly configured installed GSQL queries.", "uses": ["nodal:GSQL", "nodal:RESTPP"], "supports": ["nodal:Query", "nodal:Traversal", "nodal:AtomicRequestMutation", "nodal:MigrationsWithAdministrativeTransport", "nodal:ConditionalAnalytics"]},
    {"@id": "nodal:ConditionalAnalytics", "@type": "nodal:Capability", "name": "Conditional graph analytics", "description": "Analytics are advertised only when their provider extension or installed query is configured.", "algorithms": ["ArticleRank", "ArticulationPoints", "BetweennessCentrality", "Bridges", "CelfInfluenceMaximization", "ClosenessCentrality", "DegreeCentrality", "EigenvectorCentrality", "HarmonicCentrality", "Hits", "PageRank", "CliqueCounting", "Conductance", "Hdbscan", "KCoreDecomposition", "K1Coloring", "KMeans", "LabelPropagation", "Leiden", "LocalClusteringCoefficient", "Louvain", "Modularity", "ModularityOptimization", "StronglyConnectedComponents", "TriangleCount", "WeaklyConnectedComponents", "ApproximateMaximumKCut", "SpeakerListenerLabelPropagation", "ShortestPath", "AllShortestPaths", "Dijkstra", "AStar", "YenKShortestPaths"]},
    {"@id": "nodal:NodalMigrations", "@type": "nodal:Package", "name": "Nodal.Migrations", "description": "Portable graph schema intent, deterministic planning, and provider execution.", "requires": "nodal:MigrationDialect"}
  ],
  "schema:version": "0.1.0-alpha",
  "schema:dateModified": "2026-08-21"
}
